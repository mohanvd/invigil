# Secrets: Wi-Fi password, MQTT credentials, hash salt.
# Commit only the *.example templates (last rule in this file).
server/config.toml
secrets.*
.env
*.passwd

# Raw captures never leave the laptop. Anonymized samples go in data/samples/.
data/raw/*
!data/raw/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# PlatformIO / ESP-IDF
.pio/
firmware/**/build/
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch

# Dashboard
node_modules/
dist/

# OS and editor clutter
.DS_Store
Thumbs.db
desktop.ini

# Templates are always committed, even if a rule above matches them.
!*.example
