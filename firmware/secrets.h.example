// Copy this file to firmware/secrets.h and fill it in.
// firmware/secrets.h is gitignored. Never commit real values.

#ifndef INVIGIL_SECRETS_H
#define INVIGIL_SECRETS_H

// Wi-Fi network in the hall. WPA2 personal only.
#define WIFI_SSID "your-wifi-name"
#define WIFI_PASSWORD "your-wifi-password"

// The laptop running Mosquitto. An IPv4 address, not a host name.
// Find it with ipconfig on the laptop.
#define MQTT_HOST "192.168.1.10"
#define MQTT_PORT 1883
// Same login as server/config.toml and server/mosquitto.passwd.
// Leave both empty only if the broker allows anonymous clients.
#define MQTT_USER "invigil"
#define MQTT_PASSWORD ""

// Salt for hashing Bluetooth addresses. Must be the same as hash_salt in
// server/config.toml. Use a long random string, for example the output of:
//   python -c "import secrets; print(secrets.token_hex(16))"
// The unit refuses to publish BLE readings while this is empty.
#define HASH_SALT ""

// Unit ID, as listed in NODE_IDS in server/contract.py.
#define NODE_ID "N1"

// Time server. If the hall network has no internet, run an NTP server on
// the laptop and put its IP address here.
#define SNTP_SERVER "pool.ntp.org"

#endif
