# Invigil node, ESP32-S3 N16R8. Applied when sdkconfig.node is first generated.
# After editing this file, delete sdkconfig.node so the changes take effect.

# Flash: 16 MB quad SPI (the "N16" in N16R8)
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# Wi-Fi + NimBLE + MQTT does not fit the default 1 MB app partition
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# PSRAM: 8 MB octal (the "R8" in N16R8). Octal PSRAM uses GPIO35 to GPIO37.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# Bluetooth: NimBLE host in the observer role only.
# The node listens and never advertises or connects.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n

# Wi-Fi and Bluetooth share the ESP32-S3 radio
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

# Re-sync the clock every minute instead of every hour, so timestamps from the
# three nodes stay aligned. Placeholder: measure the drift and adjust.
CONFIG_LWIP_SNTP_UPDATE_DELAY=60000

CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
