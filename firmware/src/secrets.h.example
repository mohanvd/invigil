// Node secrets and site settings.
// Copy this file to secrets.h in the same folder and fill it in.
// secrets.h is gitignored. Never commit real values.

#pragma once

// Wi-Fi network shared by the nodes and the laptop.
#define INVIGIL_WIFI_SSID      ""
#define INVIGIL_WIFI_PASSWORD  ""

// Mosquitto on the laptop. Use the laptop's IP address (ipconfig), not localhost.
#define INVIGIL_MQTT_URI       "mqtt://192.168.1.10:1883"
#define INVIGIL_MQTT_USERNAME  "invigil"
#define INVIGIL_MQTT_PASSWORD  ""

// This node: "N1", "N2" or "N3". Change it before flashing each board.
#define INVIGIL_NODE_ID        "N1"

// Salt for hashing BLE addresses. Must be the same as hash_salt in server/config.toml.
#define INVIGIL_HASH_SALT      ""

// Time server. Readings need real timestamps or the logger rejects them.
// pool.ntp.org needs internet access. On an offline network, run an NTP
// server on the laptop and put its IP address here.
#define INVIGIL_NTP_SERVER     "pool.ntp.org"
